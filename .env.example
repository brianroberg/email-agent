# API Proxy Configuration
# Copy this file to .env and fill in your values

# API key for authenticating with the proxy server
# Format: aproxy_<32-alphanumeric-characters>
PROXY_API_KEY=aproxy_your_api_key_here
# The proxy's approval window in seconds (its --confirmation-timeout; default
# 300, 0 = the proxy waits forever). Must match the proxy: gated calls
# (/trash, /untrash) wait this long plus 30 s for the operator's decision.
# PROXY_CONFIRMATION_TIMEOUT=300

# Authentication for callers of this service (see "Authentication" in README.md)
# Comma-separated name:token pairs, one per caller. A name is 1-31 characters
# (letters, digits, '.', '_', '-'); a token is at least 32 printable ASCII
# characters with no spaces, commas or colons. Mint one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is too short to be accepted: in the default mode the
# service refuses to start until a real token is in its place. With
# EMAIL_AGENT_AUTH=off this list is not read, so the placeholder can stay.
EMAIL_AGENT_API_KEYS=assistant:replace-with-a-minted-token
# required (the default): every route except /health needs a token
# optional: requests without a token are served and logged (for rollout)
# off: no authentication (warns at start-up; EMAIL_AGENT_API_KEYS is not read)
# EMAIL_AGENT_AUTH=required

# URL of the proxy server (optional - defaults to Docker host)
# PROXY_URL=http://host.docker.internal:8000

# Local LLM Configuration (optional)
# MLX_URL=http://localhost:8080/v1/chat/completions
# MLX_MODEL=qwen/qwen3-14b
# Product name of the server behind MLX_URL, used only in diagnostic/error text
# ("Cannot reach {name} at {MLX_URL} ..."). Set it to what is actually deployed
# (default: the model server). Ollama below is an example value to opt into,
# not the default -- leave unset to keep the neutral default.
# LLM_BACKEND_NAME=Ollama
# Token budget per completion (reasoning + answer, for reasoning models)
# LLM_MAX_TOKENS=4096

# OAuth setup (one-time, run via setup_oauth.py on a machine with a browser --
# not read by email_server.py itself)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
